# Copy this file to .env.local and fill in the values

# Path to ThongTha DBF folder
# Development: ./data/ThongTha
# Docker: /data/ThongTha
DBF_DATA_PATH=./data/ThongTha

# NextAuth.js - generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=http://localhost:3000

# Users JSON array
APP_USERS=[{"username":"admin","password":"your-password","name":"Administrator","role":"admin"}]

