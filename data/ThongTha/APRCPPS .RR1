~TAXP:      0,      "",                 "tax_prd",          "tax_prd=IIF( SUBSTR(DTOS(ISTAX->TAXPRD),1,6) # SUBSTR(DTOS(ISTAX->TAXDAT),1,6), '(Â×è¹ÃÇÁã¹§Ç´ '+prd+ISTAX->LATE+')', '                     ')"
