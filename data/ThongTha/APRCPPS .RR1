~P_ISDEP:   0,      "",                 "p_isdep( A->DEPCOD )",     ""

~NN:        0,      "999",              "q",                        "q=q+1"
~ARTICLE:   43,     "",                 "article",          "article = STCRD->STKCOD - ' ' - STCRD->STKDES"
~STKCOD:    0,      "",                 "STCRD->STKCOD",    ""
~STKDES:    28,     "",                 "STCRD->STKDES",    ""
