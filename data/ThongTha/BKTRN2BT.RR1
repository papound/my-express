[print options]
Left=0
Tabs=4
Right=94
Lines=41
Output=Select, Printer, Screen, File,
File Name=BKTRN1.TXT
Print Control=\027\033\001
Fix Summary Line=ON
Select Scope=OFF
*Form=ON
Select Page=OFF
Condition=OFF

[range of report]
From=CUR

[master file]
File=bktrn
Alias=A
Tag=bktrn3
System=DATA_PATH
Filter=BKTRNTYP='BT'

[relate file]
File=bkmasx
Clone From=bkmas
Alias=R
Tag=bkmas1
System=DATA_PATH
Master file=bktrn
Master-Related Field=BNKCOD

