* ARTRNIVA.RWT - Invoice Report by Area,Salesman
*
[report frame]
Ti::~INIT ~INIT2
He:\NAME                                                    `หน้า   : \PAGE
He:$Eรายงานใบกำกับสินค้า แยกตามเขตการขาย,พนักงานขาย$E
He:วันที่จาก   ~FROMDATE     ถึง  ~TODATE                   `วันที่ : \DATE
H1:รหัสลูกค้า  ~FROMCUS      ถึง  ~TOCUS
H1:พนักงานขาย  ~FROMSLM      ถึง  ~TOSLM          เลือกแผนก  ~DEP
He:\LINE
He:  เลขที่        วันที่  ลูกค้า                                   V      ส่วนลด     มูลค่าสินค้า     VAT.       รวมทั้งสิ้น  ครบกำหนด ใบสั่งขาย    เก็บเงิน
He:~D   รายละเอียด                                         จำนวน          ราคาต่อหน่วย   ส่วนลด     จำนวนเงิน
He:\LINE
**: *IVxxxxxxx1xx DD/MM/YY xxxxxxxxx1xxxxxxxxx2xxxxxxxxx3xxxxxxxxx4 9 xxxxxxxxx1999,999,999.9999,999,999.99999,999,999.99  DD/MM/YY xxxxxxxxx1xx  Y
Gh:$Bเขตการขาย : ~AREA                                              $B~KEPTAREA ; 1 AREACOD
Gh:$B~SALESMAN                                                      $B ; 2 SLMCOD
Bo:~F~DOCNUM      ~DOCDAT  ~CUSNAM                                  ~V~DISC     ~VALAMT       ~VATAMT      ~NETAMT         ~DUEDAT  ~SONUM        ~Y
Bo:~9                                              ตัดใบรับมัดจำ#  ~ADVNUM    ~ADVAMT
Ih::~I                  ;1 stcrd->docnum artrn->docnum
Ib:     ~N  ~ARTICLE                                ~QTY      ~TQUCOD   ~UNITPR      ~DISC_I   ~NETAMT_I                           ~RDOCNUM     ;1
If:                     ;1
Ih::                    ;2 artrnrm->docnum+artrnrm->seqnum stcrd->rdocnum
Ib:        ~REMARK      ;2
Ih::                    ;3 artrnrm->docnum+artrnrm->seqnum stcrd->docnum+stcrd->seqnum
Ib:        ~REMARK      ;3
Ih:     หมายเหตุ:       ;4 artrnrm->docnum+'@' artrn->docnum+'@'
Ib:       ~REMARK       ;4
If:                     ;4
*Ih::   รับชำระหนี้ด้วย ;5 arrcpit->docnum artrn->docnum
*Ib:                           ~IT_RCPNUM ~IT_RCPDAT  ~IT_RCPDUE  ~IT_RCVAMT     ;5
Gf:                                                                             -------------- ------------ -------------               ;2
Gf:                        รวม ~SLMNAME                                         $B~SUB2VAL      ~SUB2VAT     ~SUB2NET      $B           ;2
Gf:~2                          ยอดที่ตัดใบรับมัดจำ                              $B~SUB2ADV                   ~SUB2ADVX     $B ~C_SUB2   ;2
Gf:                                                                                                                                 ;2
Gf:                                                                             -------------- ------------ -------------               ;1
Gf:                        รวมเขต ~AREANAME                                     $B~SUB1VAL      ~SUB1VAT     ~SUB1NET      $B           ;1
Gf:~1                             ยอดที่ตัดใบรับมัดจำ                           $B~SUB1ADV                   ~SUB1ADVX     $B ~C_SUB1   ;1
Gf:                                                                             ============== ============ =============               ;1
Gf:\FEED
Su:                        รวมทั้งสิ้น                                          $B~TOTVAL       ~TOTVAT      ~TOTNET       $B
Su:~0                      ยอดที่ตัดใบรับมัดจำ                                  $B~TOTADV                    ~TOTADVX      $B
Su:                                                                             ============== ============ =============
Su:หมายเหตุ:  เอกสารที่มีเครื่องหมาย '*' นำหน้า คือ เอกสารที่ถูกยกเลิก         มี ~CX ใบ
Su:                "------"     '>' นำหน้า คือ เอกสารที่รออนุมัติให้เกินวงเงิน มี ~CL ใบ
Su:
Su:>>>> จบรายงาน <<<<
[end frame]

[print options]
Top=0
Right=150
Lines=41
Output=Select, Printer, Screen, File,
File Name=ARTRNIVA.TXT
Fix Foot Line=OFF
Select Scope=OFF
Select Page=OFF
Select Paper=15_Inch, 8_Inch, Default
8_Inch=\027\033\005
15_Inch=\027\033\001
Query=DTOS(DOCDAT)>='Date1()'.AND.DTOS(DOCDAT)<='Date2()'
Query=.AND.SLMCOD>='Slm1()'.AND.SLMCOD<='Slm2()'
Query=.AND.CUSCOD>='Cus1()'.AND.CUSCOD<='Cus2()'
Query=.AND.AREACOD>='Area1()'.AND. AREACOD<='Area2()'.AND.RECTYP='3'
Sort=AREACOD+SLMCOD+DTOS(DOCDAT)+DOCNUM

[master file]
File=ARTRN
Alias=A
Tag=ARTRN1
System=DATA_PATH

[item file]
File=STCRD
Alias=B
Tag=STCRD5
System=DATA_PATH

File=artrnrm
Alias=X
Tag=artrnrm1
System=DATA_PATH

File=arrcpit
Alias=Y
Tag=arrcpit2
System=DATA_PATH

[relate file]
File=OESLM
Alias=C
Tag=OESLM1
System=DATA_PATH
Master file=ARTRN
Master-Related Field=SLMCOD

File=ARMAS
Alias=D
Tag=ARMAS1
System=DATA_PATH
Master file=ARTRN
Master-Related Field=CUSCOD

File=stmas
Alias=E
Tag=stmas1
System=DATA_PATH
Master file=stcrd
Master-Related Field=STKCOD

[data spec]
*           len (0)default,(>0)cut,(<0)cut to new line
*~dat:      len,"pict",             "data",         "exp"
~INIT:      0,  "",                 "",             "p_det=@n_prn_detail(); prn_detail=IIF(p_det=0,':',' '); cnt=0;cx=0;cl=0"
~INIT2:     0,  "",                 "",             "sub1aft=0;sub1adv=0;sub1val=0;sub1vat=0;sub1net=0; sub2aft=0;sub2adv=0;sub2val=0;sub2vat=0;sub2net=0; totaft=0;totadv=0;tot_val=0;totvat=0;totnet=0"
~FROMDATE:  0,  "d ดดด ปปปป",       "@date1()",     ""
~TODATE:    0,  "d ดดด ปปปป",       "@date2()",     ""
~FROMCUS:   0,  "",                 "Cus1()",       ""
~TOCUS:     0,  "",                 "Cus2()",       ""
~FROMSLM:   0,  "",                 "Slm1()",       ""
~TOSLM:     0,  "",                 "Slm2()",       ""
~DEP:       0,  "",                 "Dep1()",       ""
~TODEP:     0,  "",                 "Dep2()",       ""

~AREA:      0,  "",                 "p_istab( A->AREACOD,40,1,40)",     ""
~KEPTAREA:  0,  "",                 "",             "area = ISTAB->TYPDES"
~AREANAME:  0,  "",                 "area",         ""
~CUSTOMER:  0,  "",                 "cus_nam",      "cus_nam = ARMAS->CUSNAM - ' /' - A->CUSCOD"
~CUSNAME:   0,  "",                 "cus_nam",      ""
~SALESMAN:  0,  "",                 "slm_nam",      "slm_nam = OESLM->SLMNAM - ' /' - A->SLMCOD"
~SLMNAME:   0,  "",                 "slm_nam",      ""

~F:         0,  "",                 "cancel",       "cancel=IIF(A->DOCSTAT='C',' *',IIF(A->DOCSTAT='O',' >','  ' ))"
~DOCNUM:    0,  "",                 "A->DOCNUM",    "cnt=cnt+1; cx=cx+IIF(cancel=' *',1,0); cl=cl+IIF(cancel=' >',1,0)",A
~DOCDAT:    0,  "",                 "A->DOCDAT",    "",B
~SLMCOD:    0,  "",                 "A->SLMCOD",    ""
~CUSCOD:    0,  "",                 "A->CUSCOD",    ""
~CUSNAM:   40,  "",                 "ARMAS->CUSNAM","",C
~V:         0,  "",                 "A->FLGVAT",    "",D
~AMOUNT:    0,  "99,999,999.99",    "A->AMOUNT",    "",
~DISC:      0,  "",                 "A->DISC",      "",D
~AFTAMT:    0,  "999,999,999.99",   "A->AFTDISC",   "sub2aft=sub2aft+A->AFTDISC"
~ADVAMT:    0,  "999,999,999.99",   "A->ADVAMT",    "sub2adv=sub2adv+A->ADVAMT"
~VALAMT:    0,  "999,999,999.99",   "A->NETVAL",    "sub2val=sub2val+A->NETVAL",E
~VATAMT:    0,  "99,999,999.99",    "A->VATAMT",    "sub2vat=sub2vat+A->VATAMT",F
~NETAMT:    0,  "999,999,999.99",   "A->NETAMT",    "sub2net=sub2net+A->NETAMT",G
~DUEDAT:    0,  "",                 "A->DUEDAT",    "",H
~SONUM:     0,  "",                 "A->SONUM",     "",I
~Y:         0,  "",                 "A->CMPLAPP",   "",J

~SUB2AFT:   0,  "999,999,999.99",   "sub2aft",      ""
~SUB2ADV:   0,  "999,999,999.99",   "sub2adv",      ""
~SUB2VAL:   0,  "999,999,999.99",   "sub2val",      ""
~SUB2VAT:   0,  "99,999,999.99",    "sub2vat",      ""
~SUB2NET:   0,  "999,999,999.99",   "sub2net",      ""
~C_SUB2:    0,  "",                 "",             "sub1aft=sub1aft+sub2aft; sub2aft=0; sub1adv=sub1adv+sub2adv; sub2adv=0; sub1val=sub1val+sub2val; sub2val=0; sub1vat=sub1vat+sub2vat; sub2vat=0; sub1net=sub1net+sub2net; sub2net=0"

~SUB1AFT:   0,  "999,999,999.99",   "sub1aft",      ""
~SUB1ADV:   0,  "999,999,999.99",   "sub1adv",      ""
~SUB1VAL:   0,  "999,999,999.99",   "sub1val",      ""
~SUB1VAT:   0,  "99,999,999.99",    "sub1vat",      ""
~SUB1NET:   0,  "999,999,999.99",   "sub1net",      ""
~C_SUB1:    0,  "",                 "",             "totaft=totaft+sub1aft; sub1aft=0; totadv=totadv+sub1adv; sub1adv=0; tot_val=tot_val+sub1val; sub1val=0; totvat=totvat+sub1vat; sub1vat=0; totnet=totnet+sub1net; sub1net=0"

~TOTAFT:    0,  "999,999,999.99",   "totaft",       ""
~TOTADV:    0,  "999,999,999.99",   "totadv",       ""
~TOTVAL:    0,  "999,999,999.99",   "tot_val",      ""
~TOTVAT:    0,  "99,999,999.99",    "totvat",       ""
~TOTNET:    0,  "999,999,999.99",   "totnet",       ""

~I:         0,  "",                 "",                 "seq=0"
~N:         0,  "999",              "seq",              "seq=seq+1",A
~ARTICLE:   39, "",                 "article",          "article=STCRD->STKCOD-'  '-STCRD->STKDES",B
~STKCOD:    0,  "",                 "STCRD->STKCOD",    ""
~STKDES:    0,  "",                 "STMAS->STKDES",    ""
~L:         0,  "",                 "STCRD->LOCCOD",    ""
~QTY:       0,  "qtyZ(10)",         "STCRD->TRNQTY",    "",D
~TQUCOD:    0,  "",                 "p_istab( STCRD->TQUCOD, 20, 1, 0 )",   "",E
~UNITPR:    0,  "priZ(12)",         "STCRD->UNITPR",    "",F
~DISC_I:    0,  "",                 "STCRD->DISC",      "",G
~NETAMT_I:  0,  "ZZZ,ZZZ,ZZZ.ZZ",   "STCRD->TRNVAL",    "",H
~RDOCNUM:   0,  "",                 "RDOC",             "RDOC=IIF(STCRD->RDOCNUM='  ', '                ', SUBSTR(STCRD->RDOCNUM,1,12)-'-'-SUBSTR(STCRD->RDOCNUM,13,3))",I

~D:         0,  "",                 "prn_detail",       ""
~REMARK:    0,  "",                 "ARTRNRM->REMARK",  ""

~ADVNUM:    0,  "",                 "A->ADVNUM",        ""
~SUB2ADVX:  0,  "999,999,999.99",   "tmp",              "tmp=sub2adv+sub2net"
~SUB1ADVX:  0,  "999,999,999.99",   "tmp",              "tmp=sub1adv+sub1net"
~TOTADVX:   0,  "999,999,999.99",   "tmp",              "tmp=totadv+totnet"
~9:         0,  "",                 "prnadv",           "prnadv=IIF(A->ADVAMT>0,' ',':')"
~2:         0,  "",                 "prnadv",           "prnadv=IIF(sub2adv>0,' ',':')"
~1:         0,  "",                 "prnadv",           "prnadv=IIF(sub1adv>0,' ',':')"
~0:         0,  "",                 "prnadv",           "prnadv=IIF(totadv>0,' ',':')"
~CNT:       0,  "99,999",           "cnt",              ""
~CX:        0,  "999",              "cx",               ""
~CL:        0,  "999",              "cl",               ""

~IT_RCPNUM: 0,  "",                 "ARRCPIT->RCPNUM",              ""
~IT_RCPDAT: 0,  "",                 "arrcpit_get_re_data(DOCDAT)",  ""
~IT_RCPDUE: 0,  "",                 "arrcpit_get_re_data(DUEDAT)",  ""
~IT_RCVAMT: 0,  "99,999,999.99",    "ARRCPIT->RCVAMT",              ""





